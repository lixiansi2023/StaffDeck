  "nodes": [
    {
      "node_id": "n0_collect",
      "type": "collect_info",
      "name": "识别表单与材料",
      "instruction": "本次仅审核「融资借款申请表」，适用 ZJ-R04, ZJ-R05。以材料正文确认待审表单及相关附件的类型，文件名仅供参考。B00 为待审费控/OA表单，B01 为资金池 T-1 可用余额快照，B02 为账户台账或银企主数据，B03 为三会决议或纪要，B04 为 BIP 贷款信息汇总表。从 B00 核实申请编号、原始表单编号、项目名称和实际申请事项；示例表单编号 ZJ-RZ01 仅供识别，不作为固定要求。申请事项不属于本审核范围时，提示改选对应流程。缺待审表单、申请编号或无法确认申请事项时，请求补充材料。其他材料缺失时在对应审核项说明待补正，不猜测事实。",
      "optional": false,
      "condition": null,
      "expected_user_info": [],
      "result_inputs": [],
