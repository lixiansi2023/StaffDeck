{
  "skill_id": "merged_procurement_compliance_flow",
  "name": "招采合规一体化全流程（合并）",
  "version": "1.0.0",
  "business_domain": "采购与供应链合规",
  "description": "将小明名下的采购合规相关 SOP 合并为一条贯穿流程：合作方入库尽调 → 采购资料收集与附件点验 → 采购方式/资格条件/评分细则合规 → 招标文件文本/保证金/商务合同核心条款/异议澄清弃标校验 → 合同条款风险审查与条款修改建议 → 签约材料齐备性校验 → 协审结论汇总与最终报告。否决类统一终止于否决结论节点，风险/异常类统一转人工。",
  "capability_scope": "general",
  "step_timeout_seconds": 1800,
  "trigger_intents": [
    "采购文件合规审查",
    "招采合规全流程",
    "合并采购合规校验",
    "供应商入库尽调",
    "合同合规审查"
  ],
  "user_utterance_examples": [
    "帮我做一份采购文件的全面合规审查",
    "按合并流程跑一遍招采合规检查"
  ],
  "goal": [
    "按采购合规生命周期顺序完成全链路校验",
    "任一分项否决即终止并给出否决结论与整改建议",
    "风险/异常统一升级人工，其余汇总为最终合规报告"
  ],
  "required_info": [
    "project_name",
    "attachments",
    "budget_amount"
  ],
  "slot_filling_policy": {
    "enabled": true,
    "extract_scope": "all_skill_expected_user_info",
    "multi_slot_per_turn": true,
    "skip_satisfied_steps": true,
    "description": "跨节点传递各分项校验结论与综合审批结果。",
    "target_info": [
      "check_results",
      "review_items",
      "final_conclusion"
    ]
  },
  "response_rules": [
    "否决类结论明确列出否决原因与整改建议",
    "关注类风险项汇总提示但不阻断流程",
    "最终结论结构化输出总体状态与报告链接"
  ],
  "interruption_policy": {
    "allow_interrupt": "true",
    "description": "允许用户在任意节点补充材料后继续。",
    "strategy": "resume_from_last_state"
  },
  "start_node_id": "m01",
  "terminal_node_ids": [
    "m_reject",
    "m_handoff",
    "m35",
    "m30",
    "m07"
  ],
